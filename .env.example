# Pentest AI Platform - Environment Configuration
# Copy this file to .env and update the values for your environment.
# NEVER commit the .env file to version control.

# Secret key for session signing and CSRF protection (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Flask environment: development, testing, production
FLASK_ENV=development

# Database connection URL
DATABASE_URL=sqlite:///pentest.db

# Output directory for scan results and reports
OUTPUT_DIR=output
